generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Submission {
  id             String   @id @default(cuid())
  placeName      String
  state          String
  subZone        String
  description    String
  activity       String
  duration       String
  budget         Int
  transport      String
  accommodation  String
  emoji          String   @default("🌟")
  mapLink        String?
  imageLink      String?
  videoLink      String?
  submitterName  String
  submitterEmail String
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
}
